// 这是**模板**，不要直接编译：build.rs 会先把下面几个占位符替换掉
// （@VERSION@ = 1.2.3、@VERSION4@ = 1,2,3,0、@ICON@ = 图标绝对路径），
// 再把生成物交给 rc.exe 编译进 exe。
//
// 想改版本号请改 Cargo.toml 的 [package] version（打包脚本会自动改）。
#pragma code_page(65001)

1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION     @VERSION4@
PRODUCTVERSION  @VERSION4@
FILEOS          0x00040004
FILETYPE        0x00000001
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "Maneki"
            VALUE "FileDescription",  "Maneki 视频播放器"
            VALUE "FileVersion",      "@VERSION@"
            VALUE "InternalName",     "maneki"
            VALUE "OriginalFilename", "maneki.exe"
            VALUE "ProductName",      "Maneki"
            VALUE "ProductVersion",   "@VERSION@"
            VALUE "LegalCopyright",   "MIT"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
